# Frontend
# Ohne Schraegstrich am Ende: mit ihm passt die Regel nur auf Verzeichnisse, und in
# einem Worktree ist node_modules ein Symlink auf den Hauptbaum. Der taucht sonst bei
# jedem Commit als unversionierte Datei auf.
node_modules
.vite/
frontend/node_modules
frontend/.next/
frontend/.next-verify/
frontend/.next-prod/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Playwright (E2E)
frontend/e2e/.auth/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# Coverage reports (generated by CI and local test runs)
frontend/coverage/
backend/htmlcov/
backend/coverage.xml
backend/.coverage
backend/.coverage.*


# Playwright, when started from the project root
/test-results/

# Next recreates this on every start, the path changes per build
frontend/next-env.d.ts
