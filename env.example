# DeepL API
DEEPL_API_KEY=your-deepl-api-key-here
TRANSLATION_PROVIDER=deepl
SOURCE_LANG=DE
TARGET_LANG=EN-US
# Hinweis: "EN" wird automatisch zu "EN-US" gemappt (DeepL-Anforderung)

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# KISSKI LLM API (OpenAI-kompatibel, für Skript-Erstellung)
KISSKI_API_KEY=your-kisski-api-key-here
KISSKI_BASE_URL=https://chat-ai.academiccloud.de/v1
KISSKI_MODEL=qwen3-30b-a3b-instruct-2507

# Session Auth (for frontend users)
APP_PASSWORD=admin
SESSION_SECRET=change-me-to-a-random-string
SESSION_MAX_AGE_SECONDS=86400

# Production mode: disables Swagger UI, enables secure cookies
PRODUCTION=false

# Frontend → Backend URL (set automatically in Docker via docker-compose)
# Only set manually for local dev without Docker
# BACKEND_URL=http://localhost:8000
