ADMIN_EMAIL=admin@th-luebeck.de
SESSION_SECRET=change-me-to-a-random-string

# PostgreSQL
POSTGRES_USER=kis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kis
DATABASE_URL=postgresql://kis:change-me-in-production@postgres:5432/kis

# Redis (default fits the Docker Compose setup; only override if Redis runs externally)
#REDIS_URL=redis://kis-redis:6379/0

# S3 storage (MinIO locally, Hetzner Object Storage on the server)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kis

DEEPL_API_KEY=
ELEVENLABS_API_KEY=

# Provider selection (LLM + embedding) is managed via the admin panel — not via env vars.
# Three interchangeable OpenAI-compatible provider slots: primary / fallback / local.
#
# Primary slot (today: KISSKI / GWDG Academic Cloud)
PRIMARY_PROVIDER_API_KEY=
PRIMARY_PROVIDER_BASE_URL=https://chat-ai.academiccloud.de/v1
# curl https://chat-ai.academiccloud.de/v1/models -H "Authorization: Bearer YOUR_API_KEY"
# Legacy env names KISSKI_API_KEY / KISSKI_BASE_URL are still accepted
# (see AliasChoices in backend/src/config.py).

# Secondary slot (today: TH Luebeck myLab platform) — for Whisper, image, embeddings, OCR.
# No API key required inside the TH network. Empty default = slot disabled.
SECONDARY_PROVIDER_BASE_URL=https://models.mylab.th-luebeck.dev
# Legacy env names FALLBACK_PROVIDER_BASE_URL / MYLAB_BASE_URL are still accepted.

# Local slot (today: Ollama in Docker) — only relevant when enabled in the admin panel.
LOCAL_PROVIDER_BASE_URL=http://ollama:11434/v1
# Legacy env name OLLAMA_BASE_URL is still accepted.

# Model names per provider slot live in the DB and are managed via the admin panel
# (see runtime_models.py: primary_llm_model, fallback_llm_model, etc.).

# Kokoro TTS server (free, local via Docker) — leave empty to disable.
# docker-compose --profile kokoro up -d
KOKORO_BASE_URL=http://kis-kokoro:8880

# myLab TTS endpoint (TH Luebeck, Coqui XTTS-v2) — no API key needed.
MYLAB_TTS_BASE_URL=https://models.mylab.th-luebeck.dev

# LDAP — defaults point at the local kis-openldap simulator.
# For production, swap LDAP_SERVER / LDAP_BIND_DN / LDAP_BIND_PASSWORD to the
# real THL values (e.g. ldap.th-luebeck.de, cn=kis-service,..., real password).
LDAP_SERVER=kis-openldap
LDAP_PORT=389
LDAP_BASE_DN=dc=th-luebeck,dc=de
LDAP_BIND_DN=cn=admin,dc=th-luebeck,dc=de
LDAP_BIND_PASSWORD=admin
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_FULLNAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_AFFILIATION=employeeType
LDAP_ROLE_LECTURER_VALUES=staff,faculty
LDAP_USE_SSL=false


# ============================ DEV ONLY ============================
# Values below are intended for local development only.
# In production (Hetzner / THL VM) either omit them or let
# deploy/start-nginx.sh override them.
# ==================================================================

# Demo mode: true = use local backend/demo/ files, false/unset = S3 (code default).
# Set to true in dev so you can try things without configuring S3.
DEMO_LOCAL=true

# Langfuse LLM observability (container lives in docker-compose.dev.yml only).
# Dashboard: http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://kis-langfuse:3000
