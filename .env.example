# Verfügbare Sprachen (kommasepariert, erweiterbar)
TRANSLATION_LANGUAGES=DE,EN-US,FR,ES,IT,NL,PL,PT-BR

# Admin
ADMIN_EMAIL=admin@th-luebeck.de

# S3 Storage (MinIO lokal, Hetzner Object Storage auf Server)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kis

# Demo-Modus: true = lokales backend/demo/ nutzen, false/nicht gesetzt = S3
DEMO_LOCAL=true

# API Keys
DEEPL_API_KEY=
ELEVENLABS_API_KEY=

# Provider-Auswahl (LLM + Embedding) erfolgt im Admin-Panel — keine Env-Var.
# Drei austauschbare OpenAI-kompatible Provider-Slots: primary / fallback / local.
#
# Primary slot (heute: KISSKI / GWDG Academic Cloud)
PRIMARY_PROVIDER_API_KEY=
PRIMARY_PROVIDER_BASE_URL=https://chat-ai.academiccloud.de/v1
# curl https://chat-ai.academiccloud.de/v1/models -H "Authorization: Bearer DEIN_API_KEY"
# Legacy ENV-Namen KISSKI_API_KEY / KISSKI_BASE_URL werden weiterhin gelesen
# (siehe AliasChoices in backend/src/config.py).

# Local slot (heute: Ollama in Docker) — nur relevant wenn im Admin-Panel aktiviert.
LOCAL_PROVIDER_BASE_URL=http://ollama:11434/v1
# Legacy ENV-Name OLLAMA_BASE_URL wird weiterhin gelesen.

# Modellnamen pro Provider-Slot liegen in der DB und werden ueber das Admin-Panel
# verwaltet (siehe runtime_models.py: primary_llm_model, fallback_llm_model usw.).

# Kokoro TTS-Server (kostenlos, lokal via Docker) — leer lassen = deaktiviert
# docker-compose --profile kokoro up -d
# Intern (Docker Compose): http://kis-kokoro:8880
KOKORO_BASE_URL=http://kis-kokoro:8880

# myLab TTS Endpoint (TH Lübeck, Coqui XTTS-v2) — Kein API-Key nötig.
# TTS-Slot heisst namentlich "mylab", weil TTS-Provider eine flache Liste sind
# (kein primary/fallback/local), und mylab hier die konkrete Server-Identitaet ist.
MYLAB_TTS_BASE_URL=https://models.mylab.th-luebeck.dev

# Fallback slot (heute: TH Lübeck myLab Plattform) — für Whisper, Image, Embeddings, OCR.
# Kein API-Key nötig im TH-Netz. Default leer = Slot deaktiviert.
FALLBACK_PROVIDER_BASE_URL=https://models.mylab.th-luebeck.dev
# Legacy ENV-Name MYLAB_BASE_URL wird weiterhin gelesen.

# Presenton (AI Presentation Generator) — docker compose --profile presenton up -d
# Kostenloser API-Key: https://www.pexels.com/api/ — für Bilder auf Folien
PEXELS_API_KEY=
PRESENTON_IMAGE_PROVIDER=pexels

# Langfuse LLM Observability — Dashboard: http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# HuggingFace Token für pyannote Diarisierung (kostenlos: huggingface.co → Settings → Access Tokens)
# Lizenz akzeptieren: huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# PostgreSQL
POSTGRES_USER=kis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kis
DATABASE_URL=postgresql://kis:change-me-in-production@postgres:5432/kis

# Security
SESSION_SECRET=change-me-to-a-random-string

# LDAP Configuration
LDAP_SERVER=ldap.th-luebeck.de
LDAP_PORT=389
LDAP_BASE_DN=dc=th-luebeck,dc=de
LDAP_BIND_DN=cn=kis-service,dc=th-luebeck,dc=de
LDAP_BIND_PASSWORD=
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_FULLNAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_AFFILIATION=employeeType
LDAP_ROLE_LECTURER_VALUES=staff,faculty
LDAP_USE_SSL=false
