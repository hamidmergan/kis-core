ADMIN_EMAIL=admin@th-luebeck.de
SESSION_SECRET=change-me-to-a-random-string

# AES-GCM secret that encrypts provider API keys, both at rest in the
# database and in exported/imported config backups. NEVER change or delete
# it, otherwise stored keys and old backups become unreadable.
KIS_SECRETS_KEY=change-me-to-a-random-string

# Backend worker processes. Empty = automatic (cores minus one, max 8).
# Set to 1 to fall back to a single process.
#WEB_CONCURRENCY=

# PostgreSQL
POSTGRES_USER=kis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kis
DATABASE_URL=postgresql://kis:change-me-in-production@postgres:5432/kis

# S3 storage (MinIO locally, Hetzner Object Storage on the server)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kis

# AI providers (LLM, embedding, TTS, OCR, DeepL, Docling, image, vision, ...)
# are NOT configured via env vars. After first start, log in as admin and
# add providers under Admin → KI. Capabilities + feature routing happen there.

# LDAP — defaults point at the local kis-openldap simulator.
# For production, swap LDAP_SERVER / LDAP_BIND_DN / LDAP_BIND_PASSWORD to the
# real THL values (e.g. ldap.th-luebeck.de, cn=kis-service,..., real password).
LDAP_SERVER=kis-openldap
LDAP_PORT=389
LDAP_BASE_DN=dc=th-luebeck,dc=de
LDAP_BIND_DN=cn=admin,dc=th-luebeck,dc=de
LDAP_BIND_PASSWORD=admin
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_FULLNAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_AFFILIATION=employeeType
LDAP_ROLE_LECTURER_VALUES=staff,faculty
LDAP_USE_SSL=false

# Which modules this installation runs, comma-separated from aia and tools.
# Empty or omitted means both, a change needs a restart.
# Write without quotes and without spaces.
MODULES=aia,tools

# Compose reads the three lines below itself, so plain `docker compose up -d`
# starts the same stack on macOS, Linux and Windows. COMPOSE_PATH_SEPARATOR
# forces the colon, which Windows would otherwise expect as a semicolon.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.app.yml
COMPOSE_PROFILES=${MODULES:-aia,tools},app


# ============================ DEV ONLY ============================
# Values below are intended for local development only.
# In production (Hetzner / THL VM) either omit them or let
# deploy/start-nginx.sh override them.
# ==================================================================

# Langfuse LLM observability (container lives in docker-compose.dev.yml only).
# Dashboard: http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://kis-langfuse:3000
