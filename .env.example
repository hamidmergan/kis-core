# Translation language settings
SOURCE_LANG=DE
TARGET_LANG=EN-US

# Admin
ADMIN_EMAIL=admin@th-luebeck.de

# S3 Storage (MinIO lokal, Hetzner Object Storage auf Server)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kis

# API Keys
DEEPL_API_KEY=
ELEVENLABS_API_KEY=

# LLM Provider: "kisski" (Standard) oder "ollama" (lokal, kein Token-Limit)
LLM_PROVIDER=kisski

# KISSKI (GWDG Academic Cloud)
KISSKI_API_KEY=
KISSKI_BASE_URL=https://chat-ai.academiccloud.de/v1
KISSKI_MODEL=qwen3-30b-a3b-instruct-2507

# Ollama (lokal) — nur relevant wenn LLM_PROVIDER=ollama
# Via Docker-Profile (docker compose --profile ollama up -d): http://ollama:11434/v1
# Nativ auf Windows/Mac (ohne Docker): http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:8b

# Kokoro TTS-Server (kostenlos, lokal via Docker) — leer lassen = deaktiviert
# docker-compose --profile kokoro up -d
# Intern (Docker Compose): http://kis-kokoro:8880
KOKORO_BASE_URL=http://kis-kokoro:8880

# PostgreSQL
POSTGRES_USER=kis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=kis
DATABASE_URL=postgresql://kis:change-me-in-production@postgres:5432/kis

# Security
SESSION_SECRET=change-me-to-a-random-string

# Encryption key (Fernet) — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LDAP Configuration
LDAP_SERVER=ldap.th-luebeck.de
LDAP_PORT=389
LDAP_BASE_DN=dc=th-luebeck,dc=de
LDAP_BIND_DN=cn=kis-service,dc=th-luebeck,dc=de
LDAP_BIND_PASSWORD=
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_FULLNAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_USE_SSL=false
