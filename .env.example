# DeepL Translation API
DEEPL_API_KEY=your-deepl-api-key-here
TRANSLATION_PROVIDER=deepl
SOURCE_LANG=DE
TARGET_LANG=EN-US
# Hinweis: "EN" wird automatisch zu "EN-US" gemappt (DeepL-Anforderung)

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id-here

# KISSKI LLM API (OpenAI-kompatibel, für Skript-Erstellung)
KISSKI_API_KEY=your-kisski-api-key-here
KISSKI_BASE_URL=https://chat-ai.academiccloud.de/v1
KISSKI_MODEL=qwen3-30b-a3b-instruct-2507

# Security
SESSION_SECRET=change-me-to-a-random-string
SESSION_MAX_AGE_SECONDS=86400

# Demo mode: serve pre-built demo data (bypasses API calls for testing)
# Place demo files in backend/demo/slides/ (PPTX, subtitles.srt, Anweisung.txt, *.mp3)
DEMO_DATA=false

# Encryption key for sensitive database values (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LDAP Configuration (get these from your IT department)
# LDAP_SERVER=ldap.th-luebeck.de
# LDAP_PORT=389
# LDAP_BASE_DN=dc=th-luebeck,dc=de
# LDAP_BIND_DN=cn=kis-service,dc=th-luebeck,dc=de
# LDAP_BIND_PASSWORD=
# LDAP_ATTR_USERNAME=uid
# LDAP_ATTR_FULLNAME=cn
# LDAP_ATTR_EMAIL=mail
# LDAP_USE_SSL=false

# Frontend → Backend URL (set automatically in Docker via docker-compose)
# Only set manually for local dev without Docker
# BACKEND_URL=http://localhost:8000
