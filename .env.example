# DeepL Translation language settings (API keys are managed in Admin → API-Keys)
SOURCE_LANG=DE
TARGET_LANG=EN-US
# Hinweis: "EN" wird automatisch zu "EN-US" gemappt (DeepL-Anforderung)
# KISSKI/ElevenLabs/DeepL API-Keys werden im Admin-Interface unter "API-Keys" verwaltet

# Security
SESSION_SECRET=change-me-to-a-random-string

# Encryption key for sensitive database values (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# LDAP Configuration (get these from your IT department)
# LDAP_SERVER=ldap.th-luebeck.de
# LDAP_PORT=389
# LDAP_BASE_DN=dc=th-luebeck,dc=de
# LDAP_BIND_DN=cn=kis-service,dc=th-luebeck,dc=de
# LDAP_BIND_PASSWORD=
# LDAP_ATTR_USERNAME=uid
# LDAP_ATTR_FULLNAME=cn
# LDAP_ATTR_EMAIL=mail
# LDAP_USE_SSL=false

# Frontend → Backend URL (set automatically in Docker via docker-compose)
# Only set manually for local dev without Docker
# BACKEND_URL=http://localhost:8000
